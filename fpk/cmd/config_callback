#!/bin/bash

set -eu

: "${TRIM_APPDEST:?TRIM_APPDEST is required}"
: "${TRIM_PKGETC:?TRIM_PKGETC is required}"
: "${TRIM_PKGVAR:?TRIM_PKGVAR is required}"

fail() {
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        printf '%s\n' "$1" > "$TRIM_TEMP_LOGFILE" 2>/dev/null || true
    fi
    printf '%s\n' "$1" >&2
    exit 1
}

app_root="$TRIM_APPDEST"
if [ -x "$app_root/target/server/aria2-manager" ]; then
    app_root="$app_root/target"
fi

# 与安装流程同一个落盘入口：只覆盖用户提交的字段，未填写的端口、密钥、下载目录保持原值。
# 退出码 2 表示配置与密钥都没有变化（例如用户原样保存）。
if apply_output=$("$app_root/server/aria2-manager" --apply-wizard \
        --config "$TRIM_PKGETC/config.json" --secret "$TRIM_PKGETC/rpc.secret" 2>&1); then
    apply_code=0
else
    apply_code=$?
fi
case "$apply_code" in
    0) ;;
    2) exit 0 ;;
    *) fail "${apply_output:-保存应用配置失败。}" ;;
esac
printf '%s\n' "$apply_output" | while IFS= read -r line; do
    [ -n "$line" ] || continue
    printf '%s\n' "$line" >> "$TRIM_PKGVAR/startup.log"
done 2>/dev/null || true

# 生命周期脚本可能以 root 身份执行，恢复专属用户属主与最小权限，避免下次启动读不到配置。
chown aria2:aria2 "$TRIM_PKGETC/config.json" "$TRIM_PKGETC/rpc.secret" 2>/dev/null || true
chmod 600 "$TRIM_PKGETC/config.json" "$TRIM_PKGETC/rpc.secret" 2>/dev/null || true

# 这里刻意不自行重启。应用中心的保存按钮是「保存并重启」，它在配置流程返回后会调用
# POST /v1/restart 完成重启；回调里再重启一次会与它撞车，表现为“保存成功”之后紧接着
# 弹出“服务异常”。配置已落盘，端口、密钥与下载目录在应用中心触发的重启中由
# cmd/main 重新生成 aria2.conf 后生效。
printf '%s\n' "$(date '+%Y-%m-%d %H:%M:%S') 应用设置已保存，等待应用中心重启生效" >> "$TRIM_PKGVAR/startup.log" 2>/dev/null || true

exit 0
