#!/bin/bash

set -eu

# 安装向导与「应用中心 → 应用设置」共用同一组字段与同一套校验口径。这里只做输入校验，
# 不写任何文件：install_init 在应用文件落地之前执行，此时管理器二进制还不存在。
fail() {
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        printf '%s\n' "$1" > "$TRIM_TEMP_LOGFILE" 2>/dev/null || true
    fi
    printf '%s\n' "$1" >&2
    exit 1
}

valid_port() {
    value="$1"
    case "$value" in
        *[!0-9]*|'')
            return 1
            ;;
    esac
    [ "$value" -ge 1024 ] && [ "$value" -le 65535 ]
}

rpc_port="${wizard_rpc_port:-6800}"
listen_port="${wizard_listen_port:-6888}"
dht_port="${wizard_dht_listen_port:-$listen_port}"

valid_port "$rpc_port" || fail "RPC 监听端口必须是 1024-65535 之间的整数。"
valid_port "$listen_port" || fail "BT 监听端口必须是 1024-65535 之间的整数。"
valid_port "$dht_port" || fail "DHT 监听端口必须是 1024-65535 之间的整数。"
[ "$rpc_port" != "$listen_port" ] || fail "RPC 监听端口不能与 BT 监听端口相同。"

secret="${wizard_rpc_secret:-}"
if [ -n "$secret" ]; then
    # 与 aria2-manager 的校验保持一致：下限 8 位，上限 128 位，只接受可见 ASCII
    # （0x21-0x7E，即不含空格与控制字符）。aria2 的配置解析按行原样保留取值，
    # 符号本身无害；换行会插入新配置项，空白会让值带上不可见差异，因此排除。
    [ "${#secret}" -ge 8 ] && [ "${#secret}" -le 128 ] || \
        fail "RPC 密钥需为 8-128 位可见字符（字母、数字或符号，不含空格）。"
    if [ "$(printf '%s' "$secret" | LC_ALL=C tr -d '\041-\176' | wc -c)" -ne 0 ]; then
        fail "RPC 密钥只能包含可见字符（字母、数字或符号），不能有空格或中文。"
    fi
fi

mode="${wizard_special_mode:-move}"
case "$mode" in
    move|off|keep) ;;
    *) fail "下载完成后自动归档只能选择开启、关闭或保持当前设置。" ;;
esac

download_root="${wizard_download_root:-}"
if [ -n "$download_root" ]; then
    case "$download_root" in
        /*) ;;
        *) fail "下载文件夹必须是绝对路径，例如 /vol1/1000/downloads。" ;;
    esac
    case "$download_root" in
        *'"'*|*'\'*|*$'\n'*|*$'\r'*)
            fail "下载文件夹路径不能包含引号、反斜杠或换行。"
            ;;
    esac
fi

exit 0
