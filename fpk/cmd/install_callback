#!/bin/bash

set -eu

test -n "$TRIM_APPDEST"
test -n "$TRIM_PKGETC"
test -n "$TRIM_PKGVAR"

fail() {
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        printf '%s\n' "$1" > "$TRIM_TEMP_LOGFILE" 2>/dev/null || true
    fi
    printf '%s\n' "$1" >&2
    exit 1
}

valid_port() {
    value="$1"
    case "$value" in
        *[!0-9]*|'')
            return 1
            ;;
    esac
    [ "$value" -ge 1024 ] && [ "$value" -le 65535 ]
}

# 安装流程可能被重复执行，这里把 install_init 的校验再做一次：文档要求脚本消费向导值前
# 重新校验，且 install_init 与 install_callback 之间用户环境可能已经变化。
rpc_port="${wizard_rpc_port:-6800}"
listen_port="${wizard_listen_port:-6888}"
dht_port="${wizard_dht_listen_port:-$listen_port}"

valid_port "$rpc_port" || fail "RPC 监听端口必须是 1024-65535 之间的整数。"
valid_port "$listen_port" || fail "BT 监听端口必须是 1024-65535 之间的整数。"
valid_port "$dht_port" || fail "DHT 监听端口必须是 1024-65535 之间的整数。"
[ "$rpc_port" != "$listen_port" ] || fail "RPC 监听端口不能与 BT 监听端口相同。"

secret="${wizard_rpc_secret:-}"
if [ -n "$secret" ]; then
    [ "${#secret}" -ge 16 ] && [ "${#secret}" -le 64 ] || \
        fail "RPC 密钥需为 16-64 位字母、数字、点、下划线或连字符。"
    case "$secret" in
        *[!A-Za-z0-9._-]*) fail "RPC 密钥只能包含字母、数字、点、下划线或连字符。" ;;
    esac
fi

mode="${wizard_special_mode:-move}"
case "$mode" in
    move|off|keep) ;;
    *) fail "下载完成后自动归档只能选择开启、关闭或保持当前设置。" ;;
esac

download_root="${wizard_download_root:-}"
if [ -n "$download_root" ]; then
    case "$download_root" in
        /*) ;;
        *) fail "下载文件夹必须是绝对路径，例如 /vol1/1000/downloads。" ;;
    esac
    case "$download_root" in
        *'"'*|*'\'*|*$'\n'*|*$'\r'*)
            fail "下载文件夹路径不能包含引号、反斜杠或换行。"
            ;;
    esac
fi

umask 077

mkdir -p "$TRIM_PKGETC" "$TRIM_PKGVAR"
touch "$TRIM_PKGVAR/trackers.txt"

# 二进制可能位于 target 子目录，统一在此确定根路径供迁移与 chmod 复用。
# 用 if 形式判断，避免 set -e 在条件为假时直接中断安装。
app_root="$TRIM_APPDEST"
if [ -x "$app_root/target/server/aria2c" ]; then
    app_root="$app_root/target"
fi
# 先补齐可执行位，下面的配置迁移要直接调用管理进程。
chmod 755 "$app_root/server/aria2c" "$app_root/server/aria2-manager" "$app_root/server/aria2-hook"
chmod 755 "$app_root/server/aria2-hook-complete" "$app_root/server/aria2-hook-error" "$app_root/server/aria2-hook-removed"

# 覆盖安装或保留配置重装时，先把历史配置收敛到本版默认，再套用本次向导取值：
# 迁移负责补齐新增键与修正历史非法值，向导只覆盖用户明确提交的字段。
if [ -f "$TRIM_PKGETC/config.json" ]; then
    "$app_root/server/aria2-manager" --migrate-config --config "$TRIM_PKGETC/config.json" >/dev/null 2>&1 || true
fi

# 配置、端口、归档目录、下载目录与 RPC 密钥统一由管理器落盘：校验规则、目录创建和
# 属主继承都在同一处实现，避免 shell 里再拼一份 JSON 与权限逻辑。
if ! apply_output=$("$app_root/server/aria2-manager" --apply-wizard --wizard-initial \
        --config "$TRIM_PKGETC/config.json" --secret "$TRIM_PKGETC/rpc.secret" 2>&1); then
    fail "${apply_output:-写入应用配置失败。}"
fi
printf '%s\n' "$apply_output" | while IFS= read -r line; do
    [ -n "$line" ] || continue
    printf '%s\n' "$line" >> "$TRIM_PKGVAR/startup.log"
done 2>/dev/null || true

setfacl -Rb "$TRIM_PKGETC" "$TRIM_PKGVAR" 2>/dev/null || true
chown -R aria2:aria2 "$TRIM_PKGETC" "$TRIM_PKGVAR"
chown root:aria2 "$TRIM_APPDEST"
chmod 775 "$TRIM_APPDEST"
chmod 750 "$TRIM_PKGETC"
chmod 600 "$TRIM_PKGETC/config.json" "$TRIM_PKGETC/rpc.secret"
chmod 600 "$TRIM_PKGVAR/trackers.txt"
