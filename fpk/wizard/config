[
  {
    "stepTitle": "网络端口",
    "items": [
      {
        "type": "text",
        "field": "wizard_rpc_port",
        "label": "RPC 监听端口（rpc-listen-port）",
        "initValue": "",
        "helpText": "留空表示保持当前设置。仅监听本机回环地址，外部访问走飞牛统一网关。",
        "rules": [
          {
            "pattern": "^[0-9]*$",
            "message": "端口只能包含数字"
          }
        ]
      },
      {
        "type": "text",
        "field": "wizard_listen_port",
        "label": "BT 监听端口（listen-port）",
        "initValue": "",
        "helpText": "留空表示保持当前设置。BT 下载使用的 TCP/UDP 端口。",
        "rules": [
          {
            "pattern": "^[0-9]*$",
            "message": "端口只能包含数字"
          }
        ]
      },
      {
        "type": "text",
        "field": "wizard_dht_listen_port",
        "label": "DHT 监听端口（dht-listen-port）",
        "initValue": "",
        "helpText": "留空表示保持当前设置。通常与 BT 监听端口保持一致。",
        "rules": [
          {
            "pattern": "^[0-9]*$",
            "message": "端口只能包含数字"
          }
        ]
      }
    ]
  },
  {
    "stepTitle": "访问与存储",
    "items": [
      {
        "type": "text",
        "field": "wizard_rpc_secret",
        "label": "RPC 密钥（rpc-secret）",
        "initValue": "",
        "helpText": "留空表示不修改。8-128 位可见字符，可用字母、数字与常见符号，不能包含空格；仅管理员可见，保存后客户端需改用新密钥。",
        "rules": [
          {
            "pattern": "^([\\x21-\\x7E]{8,128})?$",
            "message": "RPC 密钥需为 8-128 位可见字符，不能包含空格或中文"
          }
        ]
      },
      {
        "type": "radio",
        "field": "wizard_special_mode",
        "label": "下载完成后自动归档（SPECIAL_MODE）",
        "initValue": "keep",
        "helpText": "开启后任务完成即移动到下载文件夹下的 completed 子目录。",
        "options": [
          {
            "label": "保持当前设置",
            "value": "keep"
          },
          {
            "label": "开启（move）",
            "value": "move"
          },
          {
            "label": "关闭（off）",
            "value": "off"
          }
        ]
      },
      {
        "type": "text",
        "field": "wizard_download_root",
        "label": "下载文件夹路径（dir）",
        "initValue": "",
        "helpText": "留空表示保持当前设置。也可以打开 Aria2，点右上角文件夹图标 → 「选择并授权目录」，选中的目录会同时登记到「可访问的文件」并更新这里。"
      }
    ]
  }
]
